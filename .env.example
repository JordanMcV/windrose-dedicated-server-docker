# Copy to .env and adjust as needed.

# Match your host user so bind-mounted files stay owned correctly.
PUID=1000
PGID=1000

# true  = run SteamCMD app_update on every container start (track upstream)
# false = only install on first run; keep whatever version is in ./data
UPDATE_ON_START=true

# Windrose Dedicated Server Steam App ID. Override only if Valve changes it.
WINDROSE_APP_ID=4129620

# -all silences Wine's noisy channels. Set to "" for full Wine diagnostics.
WINEDEBUG=-all

# Optional ServerDescription.json overrides, applied on every container start.
# Leave blank to keep whatever is already in data/R5/ServerDescription.json.
# Setting WINDROSE_PASSWORD also flips IsPasswordProtected=true.
# Note: on a truly first boot the file doesn't exist yet, so overrides only
# take effect from the second start onwards. To clear a password later,
# blank the entry in the JSON while the container is stopped.
WINDROSE_SERVER_NAME=
WINDROSE_PASSWORD=

# World difficulty parameters, applied to data/R5/Saved/.../WorldDescription.json
# on every container start. Setting any of these forces WorldPresetType=Custom
# on next boot. Leave blank to keep what's currently in the file. Ranges per
# /data/server/DedicatedServer.md inside the container.
#
# Multipliers (float):
#   WINDROSE_MOB_HEALTH_MULTIPLIER               0.2 .. 5.0   (default 1.0)
#   WINDROSE_MOB_DAMAGE_MULTIPLIER               0.2 .. 5.0   (default 1.0)
#   WINDROSE_SHIPS_HEALTH_MULTIPLIER             0.4 .. 5.0   (default 1.0)
#   WINDROSE_SHIPS_DAMAGE_MULTIPLIER             0.2 .. 2.5   (default 1.0)
#   WINDROSE_BOARDING_DIFFICULTY_MULTIPLIER      0.2 .. 5.0   (default 1.0)
#   WINDROSE_COOP_STATS_CORRECTION_MODIFIER      0.0 .. 2.0   (default 1.0)
#   WINDROSE_COOP_SHIP_STATS_CORRECTION_MODIFIER 0.0 .. 2.0   (default 0.0)
# Tag (one of): Easy | Normal | Hard
#   WINDROSE_COMBAT_DIFFICULTY
# Bools (true | false):
#   WINDROSE_SHARED_QUESTS    co-op shared quest completion
#   WINDROSE_EASY_EXPLORE     true = no map markers (harder; legacy name)
WINDROSE_MOB_HEALTH_MULTIPLIER=
WINDROSE_MOB_DAMAGE_MULTIPLIER=
WINDROSE_SHIPS_HEALTH_MULTIPLIER=
WINDROSE_SHIPS_DAMAGE_MULTIPLIER=
WINDROSE_BOARDING_DIFFICULTY_MULTIPLIER=
WINDROSE_COOP_STATS_CORRECTION_MODIFIER=
WINDROSE_COOP_SHIP_STATS_CORRECTION_MODIFIER=
WINDROSE_COMBAT_DIFFICULTY=
WINDROSE_SHARED_QUESTS=
WINDROSE_EASY_EXPLORE=
